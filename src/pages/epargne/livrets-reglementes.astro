---
import Layout from "../../components/Layout.astro";
import { SITE_TITLE } from "../../config";
import { colors } from "../../components/notes/utils/colors";
import "../../style/placements.css";

const C_LIVRET_A = colors[1]; // jaune
const C_LDDS = colors[2]; // vert

/* ── 1. Caractéristiques ─────────────────────────────────────── */
interface Row {
  label: string;
  a: string;
  ldds: string;
  same?: boolean;
  note?: string;
}

const rows: Row[] = [
  {
    label: "Taux",
    a: "1,7 % net",
    ldds: "1,7 % net",
    same: true,
    note: "Depuis le 1er août 2026 et jusqu'au 31 janvier 2027. Fixé par l'État et révisé chaque 1er février et 1er août.",
  },
  {
    label: "Plafond des versements",
    a: "22 950 € (76 500 € pour une association)",
    ldds: "12 000 €",
    note: "Les intérêts capitalisés peuvent faire dépasser ce plafond.",
  },
  {
    label: "Qui peut l'ouvrir",
    a: "Tout le monde, y compris les mineurs",
    ldds: "Les majeurs domiciliés fiscalement en France",
  },
  {
    label: "Combien par personne",
    a: "Un seul",
    ldds: "Un seul (deux au maximum par foyer fiscal)",
  },
  {
    label: "Dépôt à l'ouverture",
    a: "10 € minimum (1,50 € à La Banque Postale)",
    ldds: "15 € minimum",
  },
  {
    label: "Fiscalité",
    a: "Intérêts exonérés d'impôt sur le revenu et de prélèvements sociaux",
    ldds: "Intérêts exonérés d'impôt sur le revenu et de prélèvements sociaux",
    same: true,
  },
  {
    label: "Disponibilité",
    a: "Retraits possibles à tout moment, sans frais",
    ldds: "Retraits possibles à tout moment, sans frais",
    same: true,
  },
  {
    label: "Calcul des intérêts",
    a: "Par quinzaine, versés le 31 décembre",
    ldds: "Par quinzaine, versés le 31 décembre",
    same: true,
    note: "Un dépôt rapporte à partir du 1er ou du 16 du mois qui suit ; un retrait cesse de rapporter dès le début de la quinzaine où il a lieu.",
  },
  {
    label: "Sécurité",
    a: "Capital garanti",
    ldds: "Capital garanti",
    same: true,
  },
  {
    label: "Où va l'argent",
    a: "≈ 60 % à la Caisse des Dépôts ; le reste finance des PME",
    ldds: "≈ 60 % à la Caisse des Dépôts ; le reste finance des PME, la transition énergétique et l'ESS",
  },
  {
    label: "Volet solidaire",
    a: "—",
    ldds: "Une fois par an, la banque propose de donner une partie de son épargne à une structure de l'économie sociale et solidaire",
  },
];

/* ── 2. Circuit de l'argent ──────────────────────────────────── */
interface FlowNode {
  id: string;
  title: string;
  amount?: string;
  body: string;
  color: string;
  link?: { href: string; label: string };
}

const flow: Record<string, FlowNode> = {
  vous: {
    id: "vous",
    title: "Vous",
    amount: "100 €",
    color: colors[5],
    body: "Vous déposez sur votre Livret A ou votre LDDS, dans n'importe quelle banque. Le taux est le même partout : c'est l'État qui le fixe, pas la banque.",
  },
  banque: {
    id: "banque",
    title: "Votre banque",
    color: colors[9],
    body: "La banque collecte les dépôts et en transfère une partie à la Caisse des Dépôts, qui lui verse une commission pour ce service.",
  },
  fonds: {
    id: "fonds",
    title: "Fonds d'épargne",
    amount: "≈ 60 €",
    color: colors[2],
    body: "Environ 60 % des dépôts du Livret A et du LDDS sont centralisés au Fonds d'épargne de la Caisse des Dépôts, avec une partie du LEP. Son rôle : transformer une épargne disponible à tout moment en prêts de très long terme. À ce stade, Livret A et LDDS sont mélangés.",
  },
  reste: {
    id: "reste",
    title: "Reste à la banque",
    amount: "≈ 40 €",
    color: colors[4],
    body: "Environ 40 % restent au bilan de votre banque. La loi l'oblige à les employer au financement des PME et des travaux d'économies d'énergie dans les bâtiments anciens ; pour le LDDS, aussi la transition énergétique et l'économie sociale et solidaire.",
  },
  prets: {
    id: "prets",
    title: "Prêts de long terme",
    color: colors[0],
    body: "Prêts jusqu'à 80 ans, accordés par la Banque des Territoires. Ils représentent environ la moitié du bilan du Fonds d'épargne (la limite est de 66 %). Priorité fixée par la loi : le logement social, qui pèse à lui seul 45 % du bilan. Viennent ensuite la politique de la ville, les investissements des collectivités (hôpitaux, écoles, eau) et de grandes infrastructures (réseau électrique, nucléaire).",
    link: { href: "#projets", label: "Voir des exemples" },
  },
  portefeuille: {
    id: "portefeuille",
    title: "Placements financiers",
    color: colors[3],
    body: "Le reste est placé en actifs financiers (obligations, actions) pour garantir la liquidité, c'est-à-dire pouvoir rembourser les épargnants à tout moment, et contribuer à leur rémunération. Ces placements peuvent inclure des actions de grandes entreprises cotées : le groupe Caisse des Dépôts est par exemple actionnaire de TotalEnergies.",
    link: { href: "#limites", label: "En savoir plus" },
  },
  pme: {
    id: "pme",
    title: "PME, rénovation, ESS",
    color: colors[6],
    body: "Crédits accordés par votre banque à des petites et moyennes entreprises, pour des travaux d'économies d'énergie et, pour le LDDS, à des acteurs de la transition énergétique et de l'économie sociale et solidaire.",
  },
};

/* ── 3. Projets financés ─────────────────────────────────────── */
type Theme = "sante" | "logement" | "education" | "energie" | "eau";

const THEMES: Record<Theme, { label: string; color: string }> = {
  sante: { label: "Santé", color: colors[5] },
  logement: { label: "Logement", color: colors[9] },
  education: { label: "Éducation", color: colors[6] },
  energie: { label: "Énergie", color: colors[1] },
  eau: { label: "Eau", color: colors[8] },
};

interface Project {
  id: string;
  theme: Theme;
  title: string;
  place: string;
  pitch: string;
  loan: string;
  /** montants en M€ pour la barre de part financée */
  loanM?: number;
  totalM?: number;
  totalLabel?: string;
  year?: string;
  details?: string[];
}

const projects: Project[] = [
  {
    id: "caen",
    theme: "sante",
    title: "Réhabilitation du CHU de Caen",
    place: "Caen · Normandie",
    pitch: "Un bâtiment de médecine et de chirurgie moderne et des plateaux médico-techniques performants, reconstruits sur l'empreinte du site actuel de la Côte de Nacre.",
    loan: "105 M€",
    loanM: 105,
    totalM: 483,
    totalLabel: "483 M€",
  },
  {
    id: "tours",
    theme: "sante",
    title: "Nouvel hôpital de Tours",
    place: "Tours · Indre-et-Loire (37)",
    pitch: "Un hôpital moderne, conçu pour être durable et économe en énergie.",
    loan: "119 M€",
  },
  {
    id: "neulliac",
    theme: "sante",
    title: "Maison de santé pluridisciplinaire",
    place: "Neulliac · Morbihan (56)",
    pitch: "Une nouvelle structure pour améliorer l'accès aux soins dans les territoires ruraux.",
    loan: "1,5 M€",
  },
  {
    id: "doulchard",
    theme: "logement",
    title: "Logements intergénérationnels",
    place: "Saint-Doulchard · Cher (18)",
    pitch: "Une offre locative pour les seniors, 23 logements individuels et 16 collectifs, pour que seniors et familles vivent côte à côte.",
    loan: "5,4 M€",
    loanM: 5.4,
    totalM: 6.4,
    totalLabel: "6,4 M€",
  },
  {
    id: "graulhet",
    theme: "education",
    title: "Rénovation du collège Pasteur",
    place: "Graulhet · Tarn (81)",
    pitch: "Rénovation énergétique et extension d'un collège de 1973 devenu très énergivore, menée sans interrompre les cours.",
    loan: "10 M€ sur 30 ans",
    loanM: 10,
    totalM: 20,
    totalLabel: "20 M€",
    year: "2023 → 2027",
    details: [
      "Économie d'énergie visée : −61 % (label BBC Effinergie Rénovation)",
      "9 550 m² rénovés et étendus · 1 037 élèves",
      "Isolation par l'extérieur, menuiseries, désamiantage, panneaux photovoltaïques",
      "Matériaux locaux : brique en terre crue de Graulhet, bois du Massif central",
      "Prêt Transformation écologique du programme Edurenov ; le reste vient de subventions (Fonds vert, FEDER) et du Département",
    ],
  },
  {
    id: "rte",
    theme: "energie",
    title: "Réseau de transport d'électricité (RTE)",
    place: "France entière",
    pitch: "Développer et moderniser le réseau haute tension pour raccorder la production bas-carbone, accompagner l'électrification et adapter le réseau au changement climatique.",
    loan: "5 Md€ d'ici 2029",
    year: "1re tranche : 1 Md€ sur 40 ans (déc. 2025)",
    details: [
      "Plus de 106 000 km de lignes haute et très haute tension",
      "Objectif : plus de 50 % d'électricité dans le mix énergétique d'ici 2050",
      "Infrastructures conçues pour durer plus de 80 ans",
    ],
  },
  {
    id: "epr2",
    theme: "energie",
    title: "Nouveau nucléaire : 6 réacteurs EPR2",
    place: "Penly (76) et autres sites",
    pitch: "Prêt bonifié et garanti par l'État pour participer, aux côtés d'EDF, à la construction de 6 réacteurs EPR2.",
    loan: "4 à 5 Md€ par an",
    year: "Pendant une douzaine d'années · annoncé en mars 2026",
    details: [
      "Calendrier des versements à définir avec EDF",
      "Sous réserve de l'accord de la Commission européenne et de la garantie de l'État, à voter en loi de finances",
      "Selon la Caisse des Dépôts, ces prêts ne réduiront pas ceux destinés au logement social",
    ],
  },
  {
    id: "smiage",
    theme: "eau",
    title: "Prévention des inondations dans la Vésubie",
    place: "Saint-Martin-Vésubie · Alpes-Maritimes (06)",
    pitch: "Aménagement de la confluence de la Loubonnière et protection de la route RM2565, par le syndicat SMIAGE.",
    loan: "10 M€",
    year: "2026",
  },
  {
    id: "argeles",
    theme: "eau",
    title: "Réutilisation des eaux usées traitées",
    place: "Argelès-sur-Mer · Pyrénées-Orientales (66)",
    pitch: "La station d'épuration valorisera près de 1,3 million de m³ d'eaux usées traitées par an pour l'agriculture locale, dans un département exposé aux sécheresses.",
    loan: "2,5 M€ sur 40 ans",
  },
  {
    id: "fouras",
    theme: "eau",
    title: "Nouvelle usine d'assainissement",
    place: "Fouras · Charente-Maritime (17)",
    pitch: "Construction d'une usine de traitement des eaux usées par le syndicat Eau17.",
    loan: "8 M€",
    year: "2026",
  },
  {
    id: "pyreneau",
    theme: "eau",
    title: "Interconnexion des réseaux d'eau potable",
    place: "Arthez-d'Asson → Baudreix · Pyrénées-Atlantiques (64)",
    pitch: "Une liaison entre réseaux pour sécuriser l'approvisionnement en eau potable, portée par le syndicat Pyren'Eau.",
    loan: "1,8 M€",
    year: "2025",
  },
  {
    id: "bagnole",
    theme: "eau",
    title: "Protection d'un captage d'eau potable",
    place: "Bagnoles de l'Orne Normandie · Orne (61)",
    pitch: "Achat de terres agricoles autour du captage de Saint-Ursin pour protéger la ressource, et renouvellement des réseaux.",
    loan: "1 M€",
    year: "2024",
  },
  {
    id: "corbere",
    theme: "eau",
    title: "Modernisation d'un canal d'irrigation",
    place: "Corbère · Pyrénées-Orientales (66)",
    pitch: "Travaux sur les réseaux de l'ASA du canal de Corbère pour améliorer les ouvrages et limiter les pertes en eau.",
    loan: "851 000 €",
  },
];

const themeCounts = Object.fromEntries(
  (Object.keys(THEMES) as Theme[]).map((t) => [t, projects.filter((p) => p.theme === t).length])
);
const toc = [
  { href: "#caracteristiques", label: "Caractéristiques" },
  { href: "#circuit", label: "Fonctionnement" },
  { href: "#difference", label: "La différence" },
  { href: "#projets", label: "Ce que ça finance" },
  { href: "#limites", label: "Limites" },
];
---

<Layout
  title={`Livret A & LDDS | ${SITE_TITLE}`}
  description="Livret A et LDDS : caractéristiques, fonctionnement, ce qu'ils financent et leurs limites."
>
  <div class="pl">
    <a href="/epargne" class="pl-back">← Tous les placements</a>

    <header>
      <span class="pl-kicker">Livrets réglementés · enveloppe fiscale</span>
      <h1 class="pl-title">Livret A &amp; LDDS</h1>
      <p class="pl-lede">
        Les deux livrets préférés des Français : sans risque, disponibles à tout moment et sans
        impôt. Leur particularité, c'est ce que devient l'argent : une grande partie est confiée à la
        Caisse des Dépôts, qui la prête pour des projets d'intérêt général.
      </p>
    </header>

    <!-- Chiffres clés -->
    <div class="kpis pl-reveal">
      <div class="kpi" style={`--c: ${C_LDDS};`}>
        <p class="kpi-v">1,7 %</p>
        <p class="kpi-l">taux net, identique pour les deux livrets</p>
      </div>
      <div class="kpi" style={`--c: ${C_LIVRET_A};`}>
        <p class="kpi-v">22 950 €</p>
        <p class="kpi-l">plafond du Livret A</p>
      </div>
      <div class="kpi" style={`--c: ${C_LDDS};`}>
        <p class="kpi-v">12 000 €</p>
        <p class="kpi-l">plafond du LDDS</p>
      </div>
      <div class="kpi" style={`--c: ${colors[5]};`}>
        <p class="kpi-v">0 €</p>
        <p class="kpi-l">d'impôt sur les intérêts</p>
      </div>
    </div>

    <div class="toc" role="navigation" aria-label="Sommaire">
      {toc.map((t, i) => (
        <a href={t.href}><span>{String(i + 1).padStart(2, "0")}</span> {t.label}</a>
      ))}
    </div>

    <!-- ─────────────── 1. Caractéristiques ─────────────── -->
    <section class="pl-section" id="caracteristiques">
      <h2 class="pl-h2"><span class="pl-h2-num">01</span> Caractéristiques</h2>

      <div class="cmp-controls">
        <div class="pl-chips" role="group" aria-label="Choisir le livret affiché">
          <button type="button" class="pl-chip" data-view="both" aria-pressed="true">Comparer</button>
          <button type="button" class="pl-chip" data-view="a" aria-pressed="false">
            <span class="pl-dot" style={`background: ${C_LIVRET_A};`}></span> Livret A
          </button>
          <button type="button" class="pl-chip" data-view="ldds" aria-pressed="false">
            <span class="pl-dot" style={`background: ${C_LDDS};`}></span> LDDS
          </button>
        </div>
        <label class="diff-toggle">
          <input type="checkbox" id="only-diff" />
          Seulement les différences
        </label>
      </div>

      <div class="cmp" id="cmp" data-view="both">
        <div class="cmp-row cmp-head" aria-hidden="true">
          <span></span>
          <span class="col-a"><span class="pl-dot" style={`background: ${C_LIVRET_A};`}></span> Livret A</span>
          <span class="col-ldds"><span class="pl-dot" style={`background: ${C_LDDS};`}></span> LDDS</span>
        </div>
        {rows.map((r) => (
          <div class:list={["cmp-row", r.same && "is-same"]}>
            <span class="cmp-label">
              {r.label}
              {r.same && <span class="same-tag pl-hand">pareil</span>}
            </span>
            {r.same ? (
              <span class="cmp-val col-merged">{r.a}</span>
            ) : (
              <>
                <span class="cmp-val col-a" data-lbl="Livret A">{r.a}</span>
                <span class="cmp-val col-ldds" data-lbl="LDDS">{r.ldds}</span>
              </>
            )}
            {r.note && <span class="cmp-note">{r.note}</span>}
          </div>
        ))}
      </div>

      <!-- Petit calcul -->
      <div class="calc pl-reveal">
        <label for="calc-amount" class="calc-q">Combien rapporte une épargne de <output id="calc-out">5 000 €</output> sur un an&nbsp;?</label>
        <input type="range" id="calc-amount" min="0" max="34950" step="50" value="5000" />
        <div class="calc-scale" aria-hidden="true">
          <span>0 €</span>
          <span class="mark" style={`left: ${(22950 / 34950) * 100}%`}>Livret A plein</span>
          <span>34 950 €</span>
        </div>
        <p class="calc-result">
          ≈ <strong id="calc-year">85 €</strong> d'intérêts par an, soit <strong id="calc-month">7 €</strong> par mois,
          à 1,7 % et sans impôt.
        </p>
        <p class="calc-fine">Estimation simple : taux supposé constant sur l'année, sans tenir compte des quinzaines. Au-delà de 22 950 €, le surplus va sur le LDDS.</p>
      </div>
    </section>

    <!-- ─────────────── 2. Fonctionnement ─────────────── -->
    <section class="pl-section" id="circuit">
      <h2 class="pl-h2"><span class="pl-h2-num">02</span> Le circuit de votre argent</h2>
      <p class="pl-p">Suivez 100 € déposés sur un livret. <span class="pl-hand hand-inline">Cliquez sur chaque étape.</span></p>

      <div class="flow" id="flow">
        <div class="flow-row one">
          <button type="button" class="node" data-node="vous" style={`--c: ${flow.vous.color};`} aria-pressed="true">
            <span class="node-t">{flow.vous.title}</span><span class="node-a">{flow.vous.amount}</span>
          </button>
        </div>
        <div class="arrow" aria-hidden="true"></div>
        <div class="flow-row one">
          <button type="button" class="node" data-node="banque" style={`--c: ${flow.banque.color};`} aria-pressed="false">
            <span class="node-t">{flow.banque.title}</span>
          </button>
        </div>
        <svg class="split" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><path d="M50 0 V5 M32.7 5 H83.6 M32.7 5 V10 M83.6 5 V10" /></svg>
        <div class="flow-row two">
          <button type="button" class="node" data-node="fonds" style={`--c: ${flow.fonds.color};`} aria-pressed="false">
            <span class="node-t">{flow.fonds.title}</span><span class="node-s">Caisse des Dépôts</span><span class="node-a">{flow.fonds.amount}</span>
          </button>
          <button type="button" class="node" data-node="reste" style={`--c: ${flow.reste.color};`} aria-pressed="false">
            <span class="node-t">{flow.reste.title}</span><span class="node-a">{flow.reste.amount}</span>
          </button>
        </div>
        <div class="flow-row three">
          <div class="sub">
            <svg class="split small" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><path d="M50 0 V5 M24.3 5 H75.7 M24.3 5 V10 M75.7 5 V10" /></svg>
            <div class="sub-nodes">
              <button type="button" class="node" data-node="prets" style={`--c: ${flow.prets.color};`} aria-pressed="false">
                <span class="node-t">{flow.prets.title}</span><span class="node-s">jusqu'à 80 ans</span>
              </button>
              <button type="button" class="node" data-node="portefeuille" style={`--c: ${flow.portefeuille.color};`} aria-pressed="false">
                <span class="node-t">{flow.portefeuille.title}</span><span class="node-s">obligations, actions</span>
              </button>
            </div>
          </div>
          <div class="sub">
            <div class="arrow short" aria-hidden="true"></div>
            <div class="sub-nodes">
              <button type="button" class="node" data-node="pme" style={`--c: ${flow.pme.color};`} aria-pressed="false">
                <span class="node-t">{flow.pme.title}</span>
              </button>
            </div>
          </div>
        </div>

        <div class="flow-panel pl-card" id="flow-panel" aria-live="polite" style={`background-color: ${flow.vous.color};`}>
          <div class="pl-card-inner">
            <h3 id="flow-title">{flow.vous.title}</h3>
            <p id="flow-body">{flow.vous.body}</p>
            <a id="flow-link" class="flow-link" href="#" hidden></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ─────────────── 3. La différence ─────────────── -->
    <section class="pl-section pl-reveal" id="difference">
      <h2 class="pl-h2"><span class="pl-h2-num">03</span> Livret A ou LDDS : quelle différence, en vrai&nbsp;?</h2>
      <div class="diff-grid">
        <div class="pl-shadow">
          <div class="pl-card" style={`background-color: ${C_LIVRET_A};`}>
            <div class="pl-card-inner">
              <span class="pl-pill">Livret A</span>
              <p class="diff-hand pl-hand">Le livret de tout le monde, enfants compris, avec le plafond le plus haut.</p>
            </div>
          </div>
        </div>
        <div class="pl-shadow left">
          <div class="pl-card" style={`background-color: ${C_LDDS};`}>
            <div class="pl-card-inner">
              <span class="pl-pill">LDDS</span>
              <p class="diff-hand pl-hand">Réservé aux majeurs, plafond plus bas, avec un volet « don solidaire ».</p>
            </div>
          </div>
        </div>
      </div>
      <div class="pl-box">
        <p class="pl-p">
          <strong>Même taux, même fiscalité, même destination.</strong> La part centralisée des deux
          livrets alimente le même Fonds d'épargne, où elle est mélangée : un euro du LDDS n'y est pas
          orienté vers des projets plus verts qu'un euro du Livret A.
        </p>
        <p class="pl-p">
          Le « durable et solidaire » du LDDS joue à la marge : sur la part restée à la banque, qui doit
          aussi financer la transition énergétique et l'économie sociale et solidaire, et via la
          proposition annuelle de don.
        </p>
      </div>
    </section>

    <!-- ─────────────── 4. Projets ─────────────── -->
    <section class="pl-section" id="projets">
      <h2 class="pl-h2"><span class="pl-h2-num">04</span> Ce que ça finance</h2>
      <p class="pl-p">
        Quelques prêts accordés par la Banque des Territoires grâce au Fonds d'épargne, pour des
        projets d'intérêt général. Ces prêts sont accordés à un taux égal à celui du Livret A
