<script>
  /* ── Sources → plans ── */
  const srcData = JSON.parse(document.getElementById("src-data")!.textContent || "{}");
  const srcButtons = document.querySelectorAll<HTMLButtonElement>(".src");
  const planEls = document.querySelectorAll<HTMLElement>(".plan");
  const arrows = document.querySelectorAll<HTMLElement>(".to-arrow");
  const panel = document.getElementById("src-panel")!;
  const select = (btn: HTMLButtonElement) => {
    const d = srcData[btn.dataset.src || ""];
    if (!d) return;
    srcButtons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
    const plans = (btn.dataset.plans || "").split(" ");
    planEls.forEach((p) => p.classList.toggle("is-off", !plans.includes(p.dataset.plan || "")));
    arrows.forEach((a) => a.classList.toggle("is-off", !plans.includes(a.dataset.for || "")));
    panel.style.backgroundColor = d.color;
    document.getElementById("src-hand")!.textContent = d.hand;
    document.getElementById("src-title")!.textContent = d.title;
    document.getElementById("src-body")!.textContent = d.body;
    const note = document.getElementById("src-note")!;
    note.textContent = d.note || "";
    note.hidden = !d.note;
    panel.classList.remove("pop");
    void panel.offsetWidth;
    panel.classList.add("pop");
  };
  srcButtons.forEach((b) => b.addEventListener("click", () => select(b)));

  /* ── Fonds solidaire ── */
  const range = document.getElementById("solid-range") as HTMLInputElement | null;
  const updateSolid = () => {
    if (!range) return;
    const v = Number(range.value);
    document.getElementById("solid-out")!.textContent = `${v} %`;
    document.getElementById("solid-poche")!.style.flexBasis = `${v}%`;
    document.getElementById("solid-classic")!.style.flexBasis = `${100 - v}%`;
    document.getElementById("solid-poche-v")!.textContent = `${v} €`;
    document.getElementById("solid-classic-v")!.textContent = `${100 - v} €`;
  };
  range?.addEventListener("input", updateSolid);
  updateSolid();

  /* ── Leviers ── */
  const tabs = document.querySelectorAll<HTMLButtonElement>(".lever-tabs .pl-chip");
  tabs.forEach((t) =>
    t.addEventListener("click", () => {
      tabs.forEach((o) => {
        const on = o === t;
        o.setAttribute("aria-selected", String(on));
        o.setAttribute("aria-pressed", String(on));
        document.getElementById(o.getAttribute("aria-controls")!)!.hidden = !on;
      });
    })
  );

  /* ── Apparition au scroll ── */
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }),
    { threshold: 0.12 }
  );
  document.querySelectorAll(".pl-reveal").forEach((el) => io.observe(el));
</script>

