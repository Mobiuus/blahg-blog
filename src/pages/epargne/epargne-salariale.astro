---
import Layout from "../../components/Layout.astro";
import { SITE_TITLE } from "../../config";
import { colors } from "../../components/notes/utils/colors";
import "../../style/placements.css";

const C_PEE = colors[4]; // bleu
const C_PER = colors[6]; // violet

/* ── 1. Les sources d'argent ─────────────────────────────────── */
type PlanKey = "pee" | "per";

interface Source {
  id: string;
  title: string;
  who: string;
  color: string;
  hand: string;
  body: string;
  plans: PlanKey[];
  note?: string;
}

const sources: Source[] = [
  {
    id: "interessement",
    title: "Intéressement",
    who: "versé par l'entreprise",
    color: colors[1],
    hand: "Une prime sur objectifs collectifs",
    body: "Prime liée à des objectifs collectifs (chiffre d'affaires, qualité, sécurité, réduction des déchets…) fixés par un accord. Si les objectifs sont atteints, la prime est versée à l'ensemble des salariés. Elle est facultative pour l'entreprise.",
    plans: ["pee", "per"],
    note: "Placée sur un plan, elle échappe à l'impôt sur le revenu. Si vous ne choisissez rien, elle va sur le PEE.",
  },
  {
    id: "participation",
    title: "Participation",
    who: "versée par l'entreprise",
    color: colors[2],
    hand: "Une part des bénéfices",
    body: "Quand l'entreprise réalise un bénéfice, une partie est redistribuée aux salariés selon une formule légale ou négociée. Elle est obligatoire dans les entreprises d'au moins 50 salariés.",
    plans: ["pee", "per"],
    note: "Placée sur un plan, elle échappe à l'impôt sur le revenu. Si vous ne choisissez rien, une moitié va sur le PER collectif (s'il existe), l'autre selon l'accord.",
  },
  {
    id: "versements",
    title: "Versements volontaires",
    who: "versés par vous",
    color: colors[4],
    hand: "Votre propre épargne",
    body: "Les sommes que vous choisissez de verser librement sur votre PEE ou votre PER collectif, depuis votre compte bancaire.",
    plans: ["pee", "per"],
    note: "Sur le PER collectif, ces versements peuvent être déduits de votre revenu imposable, dans certaines limites.",
  },
  {
    id: "abondement",
    title: "Abondement",
    who: "versé par l'entreprise",
    color: colors[7],
    hand: "Un coup de pouce de l'employeur",
    body: "Somme que l'entreprise ajoute pour compléter ce que vous versez sur le plan (versements volontaires, intéressement, participation selon l'accord). Par exemple : 1 € versé = 1 € ajouté, dans la limite d'un plafond.",
    plans: ["pee", "per"],
    note: "Plafond annuel : 8 % du plafond de la Sécurité sociale sur le PEE, 16 % sur le PER collectif.",
  },
  {
    id: "cet",
    title: "Compte épargne temps",
    who: "vos jours non pris",
    color: colors[3],
    hand: "Des congés transformés en épargne",
    body: "Le compte épargne temps (CET) permet d'accumuler des droits à partir de jours de congé, de RTT ou de primes non utilisés. Ces droits peuvent être transformés en argent et placés sur un plan d'épargne salariale.",
    plans: ["pee", "per"],
    note: "Pour la retraite : jusqu'à 10 jours par an peuvent être versés sur le PER collectif sans impôt sur le revenu.",
  },
  {
    id: "transfert",
    title: "Transfert d'autres PER",
    who: "votre épargne retraite",
    color: colors[5],
    hand: "Regrouper son épargne retraite",
    body: "L'argent d'un autre plan d'épargne retraite (ancien employeur, PER individuel…) peut être transféré sur le PER collectif.",
    plans: ["per"],
  },
];

/* ── 2. PEE vs PER collectif ────────────────────────────────── */
interface Row {
  label: string;
  pee: string;
  per: string;
  same?: boolean;
}

const rows: Row[] = [
  { label: "Objectif", pee: "Projets à moyen terme", per: "Préparer la retraite" },
  { label: "Durée de blocage", pee: "5 ans", per: "Jusqu'à la retraite" },
  {
    label: "Sortie anticipée",
    pee: "Nombreux cas : achat de la résidence principale, mariage ou PACS, naissance d'un 3e enfant, fin du contrat de travail, rénovation énergétique, achat d'un véhicule propre…",
    per: "Peu de cas : achat de la résidence principale et « accidents de la vie » (invalidité, décès du conjoint, surendettement…)",
  },
  { label: "À la sortie", pee: "Un capital", per: "Un capital, une rente, ou les deux" },
  {
    label: "Versements volontaires",
    pee: "Pas d'avantage fiscal à l'entrée",
    per: "Déductibles du revenu imposable (dans certaines limites)",
  },
  { label: "Abondement maximum", pee: "8 % du plafond de la Sécurité sociale par an", per: "16 % du plafond de la Sécurité sociale par an" },
  {
    label: "Si vous ne choisissez pas de fonds",
    pee: "Le fonds prévu par le règlement du plan",
    per: "« Gestion pilotée » : l'épargne passe progressivement vers des fonds moins risqués à l'approche de la retraite",
  },
  {
    label: "Fonds durables obligatoires",
    pee: "Au moins un fonds solidaire et au moins un fonds labellisé",
    per: "Au moins un fonds solidaire et au moins un fonds labellisé",
    same: true,
  },
];

/* ── 3. Labels ───────────────────────────────────────────────── */
interface Label {
  name: string;
  color: string;
  what: string;
  fossil: "oui" | "partiel" | "non";
  fossilText: string;
}

const labels: Label[] = [
  {
    name: "Greenfin",
    color: colors[2],
    what: "Finance la transition écologique (énergies renouvelables, efficacité énergétique…). Label public créé par le ministère de la Transition écologique.",
    fossil: "oui",
    fossilText: "Exclut toute la chaîne des énergies fossiles. Le plus exigeant sur le climat.",
  },
  {
    name: "ISR",
    color: colors[0],
    what: "Investissement socialement responsable : le fonds tient compte de critères environnementaux, sociaux et de gouvernance (ESG). Label public, réformé en 2024.",
    fossil: "partiel",
    fossilText: "Exclut le charbon et les entreprises qui lancent de nouveaux projets de pétrole ou de gaz.",
  },
  {
    name: "Finansol",
    color: colors[1],
    what: "Distingue les placements solidaires : logement très social, insertion par l'emploi, agriculture biologique, entrepreneuriat dans les pays en développement…",
    fossil: "non",
    fossilText: "Label social et solidaire : il ne porte pas sur le climat.",
  },
  {
    name: "CIES",
    color: colors[3],
    what: "Label créé par plusieurs syndicats (Comité intersyndical de l'épargne salariale) pour les gammes de fonds d'épargne salariale : critères ESG, frais, gouvernance paritaire.",
    fossil: "partiel",
    fossilText: "Exigences ESG générales, sans exclusion systématique des énergies fossiles.",
  },
];

const toc = [
  { href: "#fonctionnement", label: "Fonctionnement" },
  { href: "#plans", label: "PEE ou PER collectif" },
  { href: "#minimum", label: "Le minimum durable" },
  { href: "#solidaire", label: "Les fonds solidaires" },
  { href: "#limites", label: "Limites" },
  { href: "#agir", label: "Agir" },
];
---

<Layout
  title={`Épargne salariale | ${SITE_TITLE}`}
  description="Épargne salariale : intéressement, participation, abondement, PEE et PER collectif, fonds labellisés et solidaires."
>
  <div class="pl">
    <a href="/epargne" class="pl-back">← Tous les placements</a>

    <header>
      <span class="pl-kicker">Épargne salariale · enveloppe fiscale</span>
      <h1 class="pl-title">Épargne salariale</h1>
      <p class="pl-lede">
        Un avantage proposé par l'employeur : des primes collectives et un coup de pouce financier,
        placés dans des fonds choisis par l'entreprise. Ces fonds investissent sur les marchés :
        c'est là que se joue leur impact sur le climat.
      </p>
    </header>

    <div class="kpis pl-reveal">
      <div class="kpi" style={`--c: ${colors[9]};`}>
        <p class="kpi-v">250,8 Md€</p>
        <p class="kpi-l">d'encours d'épargne salariale et retraite d'entreprise</p>
      </div>
      <div class="kpi" style={`--c: ${colors[0]};`}>
        <p class="kpi-v">2/3</p>
        <p class="kpi-l">gérés par 3 acteurs : Amundi, Natixis IM, BNP Paribas AM</p>
      </div>
      <div class="kpi" style={`--c: ${colors[7]};`}>
        <p class="kpi-v">84 %</p>
        <p class="kpi-l">des fonds investis dans des entreprises qui développent de nouveaux projets fossiles (2024)</p>
      </div>
      <div class="kpi" style={`--c: ${colors[2]};`}>
        <p class="kpi-v">18,4 Md€</p>
        <p class="kpi-l">d'épargne solidaire passent par l'épargne salariale</p>
      </div>
    </div>

    <div class="toc" role="navigation" aria-label="Sommaire">
      {toc.map((t, i) => (
        <a href={t.href}><span>{String(i + 1).padStart(2, "0")}</span> {t.label}</a>
      ))}
    </div>

    <!-- ─────────────── 1. Fonctionnement ─────────────── -->
    <section class="pl-section" id="fonctionnement">
      <h2 class="pl-h2"><span class="pl-h2-num">01</span> D'où vient l'argent, où va-t-il&nbsp;?</h2>
      <p class="pl-p">
        Six sources peuvent alimenter deux types de plans. <span class="pl-hand hand-inline">Choisissez une source.</span>
      </p>

      <div class="src-grid" role="group" aria-label="Sources de l'épargne salariale">
        {sources.map((s, i) => (
          <button
            type="button"
            class="src"
            data-src={s.id}
            data-plans={s.plans.join(" ")}
            aria-pressed={i === 0 ? "true" : "false"}
            style={`--c: ${s.color}; --r: ${(((i * 7) % 5) - 2) * 0.5}deg;`}
          >
            <span class="src-who">{s.who}</span>
            <span class="src-t">{s.title}</span>
          </button>
        ))}
      </div>

      <div class="to-plans" aria-hidden="true">
        <span class="to-arrow" data-for="pee"></span>
        <span class="to-arrow" data-for="per"></span>
      </div>

      <div class="plans">
        <div class="plan" data-plan="pee" style={`--c: ${C_PEE};`}>
          <p class="plan-t">PEE</p>
          <p class="plan-s">Plan d'épargne entreprise</p>
          <p class="plan-x">bloqué 5 ans</p>
        </div>
        <div class="plan" data-plan="per" style={`--c: ${C_PER};`}>
          <p class="plan-t">PER collectif</p>
          <p class="plan-s">ex-PERCO</p>
          <p class="plan-x">bloqué jusqu'à la retraite</p>
        </div>
      </div>

      <div class="pl-card src-panel" id="src-panel" aria-live="polite" style={`background-color: ${sources[0].color};`}>
        <div class="pl-card-inner">
          <p class="src-hand pl-hand" id="src-hand">{sources[0].hand}</p>
          <h3 id="src-title">{sources[0].title}</h3>
          <p id="src-body">{sources[0].body}</p>
          <p class="src-note" id="src-note">{sources[0].note}</p>
        </div>
      </div>

      <p class="pl-p fcpe">
        Sur le plan, l'argent est investi dans des <strong>FCPE</strong> (fonds communs de placement
        d'entreprise) : des fonds d'actions, d'obligations ou monétaires, choisis par l'entreprise et
        gérés par une société de gestion. C'est le salarié qui répartit son épargne entre ces fonds.
      </p>
    </section>

    <!-- ─────────────── 2. PEE vs PER ─────────────── -->
    <section class="pl-section" id="plans">
      <h2 class="pl-h2"><span class="pl-h2-num">02</span> PEE ou PER collectif&nbsp;?</h2>
      <p class="pl-p">
        Le PERCO a été remplacé par le PER collectif : il n'est plus proposé depuis le 1er octobre
        2020, mais les PERCO existants continuent de fonctionner.
      </p>

      <div class="cmp">
        <div class="cmp-row cmp-head" aria-hidden="true">
          <span></span>
          <span><span class="pl-dot" style={`background: ${C_PEE};`}></span> PEE</span>
          <span><span class="pl-dot" style={`background: ${C_PER};`}></span> PER collectif</span>
        </div>
        {rows.map((r) => (
          <div class:list={["cmp-row", r.same && "is-same"]}>
            <span class="cmp-label">{r.label}</span>
            {r.same ? (
              <span class="cmp-val col-merged">{r.pee}</span>
            ) : (
              <>
                <span class="cmp-val col-pee" data-lbl="PEE">{r.pee}</span>
                <span class="cmp-val col-per" data-lbl="PER collectif">{r.per}</span>
              </>
            )}
          </div>
        ))}
      </div>
      <p class="fine">
        L'argent placé reste soumis aux prélèvements sociaux. Le plafond annuel de la Sécurité sociale
        est fixé chaque année par l'État.
      </p>
    </section>

    <!-- ─────────────── 3. Minimum durable ─────────────── -->
    <section class="pl-section" id="minimum">
      <h2 class="pl-h2"><span class="pl-h2-num">03</span> Le minimum durable, dans tous les plans</h2>
      <p class="pl-p">
        Quelle que soit l'entreprise, la loi garantit qu'au moins deux fonds « responsables » sont
        accessibles dans le plan. Encore faut-il les choisir : par défaut, l'argent va dans le fonds
        prévu par le plan, qui n'est pas forcément l'un d'eux.
      </p>

      <ol class="timeline pl-reveal">
        <li>
          <span class="tl-date">1er janv. 2010</span>
          <span class="tl-body"><strong>Loi de modernisation de l'économie</strong> : au moins un <strong>fonds solidaire</strong> doit être proposé aux salariés.</span>
        </li>
        <li>
          <span class="tl-date">1er juil. 2024</span>
          <span class="tl-body"><strong>Loi « partage de la valeur »</strong> : au moins un <strong>fonds labellisé</strong> (ISR, Greenfin, Finansol…) doit aussi être proposé.</span>
        </li>
        <li class="is-next">
          <span class="tl-date">À venir</span>
          <span class="tl-body">Réforme européenne du règlement SFDR, qui classe les fonds selon leur ambition durable (articles 6, 8 et 9 aujourd'hui), annoncée pour début 2027.</span>
        </li>
      </ol>

      <p class="pl-p labels-intro">Les labels à repérer, et ce qu'ils disent des énergies fossiles :</p>

      <div class="labels">
        {labels.map((l, i) => (
          <div class:list={["pl-shadow", i % 2 === 1 && "left"]} style={`transform: rotate(${(((i * 7) % 5) - 2) * 0.5}deg);`}>
            <div class="pl-card" style={`background-color: ${l.color};`}>
              <div class="pl-card-inner">
                <span class="pl-pill">Label</span>
                <h3 class="label-name">{l.name}</h3>
                <p class="label-what">{l.what}</p>
                <div class="pl-divider"></div>
                <div class="label-fossil">
                  <span class:list={["fossil-mark", l.fossil]} aria-hidden="true"></span>
                  <p><strong>Fossiles :</strong> {l.fossilText}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="pl-box sfdr pl-reveal">
        <p class="pl-p"><strong>Et la taxonomie européenne&nbsp;?</strong> Greenfin est le label le plus proche : il impose d'investir dans des « éco-activités » proches de la taxonomie, surtout l'<strong>atténuation</strong> (renouvelables, efficacité énergétique). Les fonds d'<strong>adaptation</strong> restent très rares.</p>
        <p class="pl-p">Chaque fonds affiche aussi une classification européenne (SFDR) : <strong>article 6</strong> (pas d'objectif durable), <strong>article 8</strong> (promeut des critères ESG), <strong>article 9</strong> (objectif d'investissement durable, le plus exigeant).</p>
      </div>
    </section>

    <!-- ─────────────── 4. Solidaire ─────────────── -->
    <section class="pl-section" id="solidaire">
      <h2 class="pl-h2"><span class="pl-h2-num">04</span> Le fonds solidaire « 85-15 »</h2>
      <p class="pl-p">
        Un fonds solidaire combine deux poches. La plus grande est investie comme un fonds classique ;
        la plus petite, la <strong>poche solidaire</strong>, finance des entreprises agréées
        « solidaires d'utilité sociale » (ESUS), souvent non cotées. Longtemps appelés « 90-10 », ces
        fonds consacrent aujourd'hui <strong>5 à 15 %</strong> de leur actif à la poche solidaire.
      </p>

      <div class="solid pl-reveal">
        <label for="solid-range" class="solid-q">Part de la poche solidaire : <output id="solid-out">10 %</output></label>
        <input type="range" id="solid-range" min="5" max="15" step="1" value="10" />
        <div class="solid-bar" aria-hidden="true">
          <div class="solid-classic" id="solid-classic"></div>
          <div class="solid-poche" id="solid-poche"></div>
        </div>
        <div class="solid-values" aria-live="polite">
          <p><span class="solid-v" id="solid-classic-v">90 €</span> poche classique</p>
          <p class="right"><span class="solid-v" id="solid-poche-v">10 €</span> poche solidaire</p>
        </div>
        <div class="solid-legend">
          <div>
            <p class="sl-t"><span class="pl-dot" style={`background: ${colors[4]};`}></span> Poche classique</p>
            <p>Actions et obligations d'entreprises cotées. Elle n'est verte que si le fonds est aussi labellisé (ISR, Greenfin) : sinon elle peut être investie dans n'importe quel secteur, y compris les énergies fossiles.</p>
          </div>
          <div>
            <p class="sl-t"><span class="pl-dot" style={`background: ${colors[1]};`}></span> Poche solidaire</p>
            <p>Logement très social, insertion par l'emploi, agriculture biologique, énergie citoyenne… Elle relève de l'utilité sociale plus que de la taxonomie climat.</p>
          </div>
        </div>
      </div>

      <div class="solid-figs pl-reveal">
        <div>
          <p class="sf-v">34 Md€</p>
          <p class="sf-l">d'épargne solidaire en France, soit 0,52 % de l'épargne financière des ménages</p>
        </div>
        <div>
          <p class="sf-v">18,4 Md€</p>
          <p class="sf-l">viennent de l'épargne salariale, un peu plus de la moitié (54 %) de l'épargne solidaire</p>
        </div>
        <div>
          <p class="sf-v">≈ 8 %</p>
          <p class="sf-l">de l'épargne salariale est placée en fonds solidaires</p>
        </div>
      </div>
    </section>

    <!-- ─────────────── 5. Limites ─────────────── -->
    <section class="pl-section" id="limites">
      <h2 class="pl-h2"><span class="pl-h2-num">05</span> Les limites</h2>
      <div class="limit-main pl-reveal">
        <p class="limit-k pl-hand">84 % des fonds financent l'expansion fossile</p>
        <p class="pl-p">
          Selon Reclaim Finance, 84 % des fonds d'épargne salariale étudiés étaient investis dans des
          entreprises qui développent de nouveaux projets d'énergies fossiles. Ces données datent de
          2024.
        </p>
      </div>
      <div class="limits-grid">
        <div class="pl-box pl-reveal">
          <p class="limit-t">Un marché très concentré</p>
          <p>Deux tiers de l'épargne salariale sont gérés par trois acteurs : Amundi, Natixis IM et BNP Paribas AM. Leurs politiques climat pèsent donc sur la majorité des salariés.</p>
        </div>
        <div class="pl-box pl-reveal">
          <p class="limit-t">Le choix par défaut n'est pas durable</p>
          <p>Sans choix du salarié, l'épargne va dans le fonds prévu par le plan. Le fonds solidaire et le fonds labellisé sont proposés, pas imposés.</p>
        </div>
        <div class="pl-box pl-reveal">
          <p class="limit-t">Un label ne suffit pas toujours</p>
          <p>Les labels n'ont pas tous les mêmes exigences sur les fossiles. Reclaim Finance alerte aussi sur des fonds présentés comme « verts » qui restent exposés à ces énergies.</p>
        </div>
      </div>
    </section>

    <!-- ─────────────── 6. Agir ─────────────── -->
    <section class="pl-section" id="agir">
      <h2 class="pl-h2"><span class="pl-h2-num">06</span> Les leviers d'action</h2>

      <div class="lever-tabs pl-chips" role="tablist" aria-label="Échelle d'action">
        <button type="button" class="pl-chip" role="tab" id="tab-indiv" aria-controls="lever-indiv" aria-selected="true" aria-pressed="true">Seul·e</button>
        <button type="button" class="pl-chip" role="tab" id="tab-coll" aria-controls="lever-coll" aria-selected="false" aria-pressed="false">Ensemble, dans l'entreprise</button>
      </div>

      <div class="lever" id="lever-indiv" role="tabpanel" aria-labelledby="tab-indiv">
        <ol class="steps">
          <li>
            <p class="step-t">Repérer les fonds labellisés dans son plan</p>
            <p>Greenfin et ISR sont les deux labels qui excluent les entreprises développant de nouveaux projets fossiles ; Greenfin va plus loin en excluant toute la chaîne fossile.</p>
          </li>
          <li>
            <p class="step-t">Choisir le fonds solidaire</p>
            <p>Il est obligatoirement proposé. Vérifier aussi si sa poche classique est labellisée.</p>
          </li>
          <li>
            <p class="step-t">Réorienter l'épargne déjà placée</p>
            <p>On peut déplacer son épargne d'un fonds à l'autre dans le plan (un « arbitrage »), sans la débloquer.</p>
          </li>
          <li>
            <p class="step-t">Vérifier ses fonds et son gestionnaire</p>
            <p>Comparer l'impact de ses fonds avec l'outil d'Epsor, et les pratiques de son gestionnaire sur change-de-banque.org (Reclaim Finance).</p>
          </li>
        </ol>
      </div>

      <div class="lever" id="lever-coll" role="tabpanel" aria-labelledby="tab-coll" hidden>
        <ol class="steps">
          <li>
            <p class="step-t">Référencer des fonds plus durables</p>
            <p>La liste des fonds proposés est négociée entre la direction et les représentants des salariés. Le CSE et les délégués syndicaux peuvent demander l'ajout de fonds Greenfin.</p>
          </li>
          <li>
            <p class="step-t">Choisir un gestionnaire engagé</p>
            <p>Lors du choix ou du renouvellement du gestionnaire d'épargne salariale, privilégier ceux qui se distinguent par leurs engagements pour le climat.</p>
            <div class="managers">
              <span class="pl-pill on-page">Gay-Lussac Gestion</span>
              <span class="pl-pill on-page">Ofi Invest Asset Management</span>
              <span class="pl-pill on-page">Mirova</span>
            </div>
            <p class="fine">Sélection de Reclaim Finance (change-de-banque.org).</p>
          </li>
          <li>
