---
import Layout from "../../components/Layout.astro";
import { SITE_TITLE } from "../../config";
import { placements, KIND_LABEL } from "../../data/placements";
import "../../style/placements.css";

// Légère inclinaison des fiches, déterministe (même rendu à chaque build)
const tilt = (i: number) => ((i * 7) % 5) - 2; // -2 … +2 deg
const shift = (i: number) => (i * 5) % 9;

const readyCount = placements.filter((p) => p.ready).length;

const counts = {
  all: placements.length,
  enveloppe: placements.filter((p) => p.kind === "enveloppe").length,
  classe: placements.filter((p) => p.kind === "classe").length,
};

---

<Layout
  title={`Placements | ${SITE_TITLE}`}
  description="Fiches pédagogiques pour comprendre les placements et ce qu'ils financent."
>
  <div class="pl">
    <header class="home-head">
      <span class="pl-kicker">Finance durable · fiches pédagogiques</span>
      <h1 class="pl-title">Où va mon épargne&nbsp;?</h1>
      <p class="pl-lede">
        Chaque fiche décrit un placement de façon factuelle : ce que c'est, comment ça marche, et
        ce que ça finance.
      </p>
      <p class="pl-lede-hand">Un placement = une enveloppe ou une classe d'actifs. On commence par les livrets.</p>
    </header>

    <!-- Légende -->
    <section class="legend pl-reveal" aria-label="Comment lire les fiches">
      <div class="legend-item">
        <span class="pl-pill on-page">Enveloppe fiscale</span>
        <p>Le <em>contenant</em> : un cadre juridique et fiscal (plafond, blocage, impôt) dans lequel on loge de l'argent ou des supports.</p>
      </div>
      <div class="legend-item">
        <span class="pl-pill on-page">Classe d'actifs</span>
        <p>Le <em>contenu</em> : un type d'investissement (prêt à un projet, immobilier, entreprise non cotée…), quelle que soit l'enveloppe.</p>
      </div>
    </section>

    <!-- Filtres -->
    <div class="pl-wide controls">
      <div class="pl-chips" role="group" aria-label="Filtrer les placements">
        <button type="button" class="pl-chip" data-filter="all" aria-pressed="true">
          <span class="pl-dot" style="background: var(--text-color);"></span>
          Tous <span class="pl-chip-count">{counts.all}</span>
        </button>
        <button type="button" class="pl-chip" data-filter="enveloppe" aria-pressed="false">
          Enveloppes fiscales <span class="pl-chip-count">{counts.enveloppe}</span>
        </button>
        <button type="button" class="pl-chip" data-filter="classe" aria-pressed="false">
          Classes d'actifs <span class="pl-chip-count">{counts.classe}</span>
        </button>
      </div>
      <p class="controls-hint">{readyCount} fiche{readyCount > 1 ? "s" : ""} prête{readyCount > 1 ? "s" : ""} · les autres arrivent</p>
    </div>

    <!-- Grille des fiches -->
    <div class="pl-wide">
      <div class="grid">
        {placements.map((p, i) => {
          const Tag = p.ready ? "a" : "div";
          return (
            <div
              class="cell"
              data-kind={p.kind}
              style={`transform: rotate(${tilt(i)}deg) translateY(${shift(i)}px);`}
            >
              <div class:list={["pl-shadow", tilt(i) < 0 && "left"]}>
                <Tag
                  href={p.ready ? `/epargne/${p.slug}` : undefined}
                  class:list={["pl-card", "fiche", !p.ready && "is-soon"]}
                  style={`background-color: ${p.color};`}
                  aria-disabled={p.ready ? undefined : "true"}
                >
                  <div class="pl-card-inner">
                    <div class="fiche-top">
                      <span class="pl-pill">{KIND_LABEL[p.kind]}</span>
                      {!p.ready && <span class="soon">bientôt</span>}
                    </div>
                    <h3 class="fiche-title">{p.title}</h3>
                    <p class="fiche-includes">{p.includes.join(" · ")}</p>
                    <div class="pl-divider"></div>
                    <p class="fiche-summary pl-hand">{p.summary}</p>
                    {p.ready && <p class="fiche-cta">Lire la fiche →</p>}
                  </div>
                </Tag>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <section class="pl-section">
      <p class="disclaimer">
        Ces fiches sont informatives et ne constituent pas un conseil en investissement.
      </p>
    </section>
  </div>
</Layout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>(".controls .pl-chip");
  const cells = document.querySelectorAll<HTMLElement>(".grid .cell");
  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const f = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      cells.forEach((cell) => {
        cell.hidden = f !== "all" && cell.dataset.kind !== f;
      });
    });
  });

  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }),
    { threshold: 0.15 }
  );
  document.querySelectorAll(".pl-reveal").forEach((el) => io.observe(el));
</script>

<style>
  .home-head {
    margin-top: 0.5rem;
  }

  .legend {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 1.5rem;
    margin-bottom: 2rem;
  }
  .legend-item p {
    margin: 0.45rem 0 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--gray);
  }
  @media (max-width: 560px) {
    .legend {
      grid-template-columns: 1fr;
    }
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }
  .controls-hint {
    margin: 0;
    font-size: 0.8rem;
    color: var(--gray);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem 1.25rem;
    align-items: start;
  }
  @media (min-width: 560px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem 1.5rem;
    }
  }
  @media (min-width: 1120px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .cell[hidden] {
    display: none;
  }

  .fiche {
    transition: filter 0.2s, translate 0.2s;
  }
  a.fiche:hover {
    filter: brightness(0.95);
    translate: 0 -3px;
  }
  .fiche.is-soon {
    cursor: default;
  }
  .fiche.is-soon .pl-card-inner {
    border-style: dashed;
  }

  .fiche-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }
  .soon {
    font-family: "Caveat", cursive;
    font-size: 1.15rem;
    line-height: 1;
    color: rgba(0, 0, 0, 0.6);
  }
  .fiche-title {
    font-size: 1.05rem;
    margin-top: 0.35rem !important;
  }
  .fiche-includes {
    font-size: 11px;
    color: rgba(0, 0, 0, 0.65);
  }
  .fiche-summary {
    font-size: 1.2rem;
    line-height: 1.15;
    color: rgba(0, 0, 0, 0.85);
  }

  .fiche-cta {
    margin-top: 0.3rem !important;
    font-size: 0.8rem;
    font-weight: 700;
    text-align: right;
  }

  .disclaimer {
    margin-top: 2rem;
    font-size: 0.75rem;
    color: var(--gray);
  }
</style>
