  | "agrivoltaique"
  | "eolien"
  | "chaleur"
  | "stockage"
  | "hydro"
  | "pyro"
  | "cee"
  | "multi";

interface ProjectType {
  key: TypeKey;
  label: string;
  emoji: string;
  color: string;
}

interface Project {
  id: string;
  date: string; // jj/mm/aaaa, "" si inconnue
  platform: string;
  company: string;
  name: string;
  location: string;
  country: string;
  rate: number | null; // taux annuel en %
  months: number | null;
  frequency: string;
  repayment: string;
  capacity: string;
  type: TypeKey;
  coords: [number, number]; // [lat, lng]
}

const types: ProjectType[] = [
