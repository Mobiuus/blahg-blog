---
import BaseHead from "../components/BaseHead.astro";
import "../style/global.css";
import "../style/fonts.css";

const paintings = [
  {
    painter: "Claude Monet",
    title: "La Gare Saint-Lazare",
    date: "1877",
    place: "Paris",
    owned_by: "Musée d'Orsay",
    image: "/assets/paintings/La_Gare_Saint-Lazare_-_Claude_Monet.jpg",
  },
  {
    painter: "Joseph Mallord William Turner",
    title: "Pluie, Vapeur et Vitesse",
    date: "1844",
    place: "Londres",
    owned_by: "National Gallery",
    image: "/assets/paintings/Turner_-_Rain,_Steam_and_Speed.jpg",
  },
  {
    painter: "Claude Monet",
    title: "La Pie",
    date: "1868",
    place: "Paris",
    owned_by: "Musée d'Orsay",
    image: "/assets/paintings/Claude_Monet_-_La_pie.jpg",
  },
];
const first = paintings[0];
---

<html lang="fr">
  <head>
    <BaseHead title="Musée imaginaire" description="Mon musée imaginaire" />
  </head>
  <body>
    <a href="/" class="pill home-link">← home</a>

    <main class="gallery">
      <!-- Cadre de taille fixe : chaque tableau s'y adapte, la page ne bouge pas -->
      <div class="stage">
        <img id="painting-image" class="painting" src={first.image} alt={first.title} />
      </div>

      <div class="caption" aria-live="polite">
        <p class="title" id="title">{first.title}</p>
        <p class="meta" id="painter-and-date">{first.painter}, {first.date}</p>
        <p class="meta" id="place-and-owned-by">{first.place}, {first.owned_by}</p>
      </div>

      <div class="thumbnails">
        {paintings.map((p, i) => (
          <button type="button" class:list={["thumb", { active: i === 0 }]} data-index={i} aria-label={p.title}>
            <img src={p.image} alt="" loading="lazy" />
          </button>
        ))}
      </div>

      <nav class="controls" aria-label="Navigation entre les tableaux">
        <button type="button" id="prev-button" class="pill">← prev</button>
        <span id="painting-index" class="index">1 / {paintings.length}</span>
        <button type="button" id="next-button" class="pill">next →</button>
      </nav>
    </main>

    <script type="application/json" id="paintings-data" set:html={JSON.stringify(paintings)}></script>
    <script>
      interface Painting {
        painter: string;
        title: string;
        date: string;
        place: string;
        owned_by: string;
        image: string;
      }

      const paintings: Painting[] = JSON.parse(document.getElementById("paintings-data")?.textContent ?? "[]");
      const image = document.getElementById("painting-image") as HTMLImageElement;
      const title = document.getElementById("title") as HTMLElement;
      const painterAndDate = document.getElementById("painter-and-date") as HTMLElement;
      const placeAndOwnedBy = document.getElementById("place-and-owned-by") as HTMLElement;
      const index = document.getElementById("painting-index") as HTMLElement;
      const thumbs = document.querySelectorAll<HTMLButtonElement>(".thumb");
      let current = 0;

      // Précharge les tableaux pour un changement instantané
      paintings.forEach((p) => {
        const img = new Image();
        img.src = p.image;
      });

      function show(i: number) {
        const p = paintings[i];
        if (!p) return;
        current = i;
        image.src = p.image;
        image.alt = p.title;
        title.textContent = p.title;
        painterAndDate.textContent = `${p.painter}, ${p.date}`;
        placeAndOwnedBy.textContent = `${p.place}, ${p.owned_by}`;
        index.textContent = `${i + 1} / ${paintings.length}`;
        thumbs.forEach((t, j) => t.classList.toggle("active", j === i));
      }

      const next = () => show((current + 1) % paintings.length);
      const prev = () => show((current - 1 + paintings.length) % paintings.length);

      document.getElementById("next-button")?.addEventListener("click", next);
      document.getElementById("prev-button")?.addEventListener("click", prev);
      thumbs.forEach((t) => t.addEventListener("click", () => show(Number(t.dataset.index))));
      // Flèches du clavier
      document.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") next();
        if (e.key === "ArrowLeft") prev();
      });
    </script>
  </body>
</html>

<style>
  /* La galerie peut être plus large que la colonne de texte du site,
     et tient sur un seul écran (sans défilement) */
  :global(html),
  :global(body) {
    max-width: 1000px;
  }
  :global(html) {
    padding: 0;
  }
  :global(body) {
    height: 100vh;
    height: 100dvh;
    box-sizing: border-box;
  }

  .gallery {
    height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2.75rem 0 0.5rem;
  }

  /* Le tableau prend toute la hauteur restante ; le reste a une hauteur fixe */
  .stage {
    width: 100%;
    flex: 1 1 auto;
    min-height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .painting {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
  }

  /* Hauteur fixe (3 lignes) pour que la suite de la page ne bouge pas */
  .caption {
    text-align: center;
    min-height: 4.6em;
    line-height: 1.5;
  }
  .caption p {
    margin: 0;
  }
  .title {
    font-weight: 700;
  }
  .meta {
    color: var(--gray);
    font-size: 0.9em;
  }

  .thumbnails {
    display: flex;
    gap: 0.6rem;
  }
  .thumb {
    width: 56px;
    height: 56px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 6px;
    background: none;
    cursor: pointer;
    overflow: hidden;
    opacity: 0.55;
    transition: opacity 0.15s, border-color 0.15s;
  }
  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb:hover,
  .thumb:focus-visible {
    opacity: 0.85;
  }
  .thumb.active {
    opacity: 1;
    border-color: var(--text-color);
  }

  .controls {
    position: static;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    background: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .index {
    min-width: 4ch;
    text-align: center;
    font-variant-numeric: tabular-nums;
    color: var(--gray);
  }

  /* Boutons en pastilles, même police que le reste du site */
  .pill {
    display: inline-block;
    font: inherit;
    font-size: 0.9rem;
    color: var(--text-color);
    background: none;
    border: 1px solid var(--text-color);
    border-radius: 999px;
    padding: 0.35rem 1rem;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.15s, color 0.15s;
  }
  .pill:hover,
  .pill:focus-visible {
    background: var(--text-color);
    color: var(--background-color);
    text-decoration: none;
  }

  .home-link {
    position: absolute;
    top: 20px;
    left: 20px;
  }

  @media (max-width: 600px) {
    .gallery {
      padding-top: 3rem;
    }
    .controls {
      gap: 0.75rem;
    }
  }
</style>
