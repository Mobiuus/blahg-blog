---
import BaseHead from "../components/BaseHead.astro";
import "../style/global.css";
import "../style/fonts.css";

const paintings = [
  {
    painter: "Claude Monet",
    title: "La Gare Saint-Lazare",
    date: "1877",
    place: "Paris",
    owned_by: "Musée d'Orsay",
    image: "/assets/paintings/La_Gare_Saint-Lazare_-_Claude_Monet.jpg",
  },
  {
    painter: "Joseph Mallord William Turner",
    title: "Pluie, Vapeur et Vitesse",
    date: "1844",
    place: "Londres",
    owned_by: "National Gallery",
    image: "/assets/paintings/Turner_-_Rain,_Steam_and_Speed.jpg",
  },
  {
    painter: "Claude Monet",
    title: "La Pie",
    date: "1868",
    place: "Paris",
    owned_by: "Musée d'Orsay",
    image: "/assets/paintings/Claude_Monet_-_La_pie.jpg",
  },
];
const first = paintings[0];
---

<html lang="fr">
  <head>
    <BaseHead title="Musée imaginaire" description="Mon musée imaginaire, en économiseur d'écran" />
  </head>
  <body class="screensaver-page">
    <a href="/" class="home-link">← home</a>

    <!-- L'écran noir : le tableau y glisse en diagonale et rebondit sur les bords -->
    <main class="screen" id="screen" aria-label="Musée imaginaire en économiseur d'écran">
      <img id="painting" class="painting" src={first.image} alt={first.title} />
    </main>

    <div class="caption" aria-live="polite">
      <p class="title" id="title">{first.title}</p>
      <p class="meta" id="meta">{first.painter}, {first.date} · {first.owned_by}</p>
    </div>

    <p class="corners" id="corners" hidden>coins : <span id="corner-count">0</span></p>

    <script type="application/json" id="paintings-data" set:html={JSON.stringify(paintings)}></script>
    <script>
      interface Painting {
        painter: string;
        title: string;
        date: string;
        place: string;
        owned_by: string;
        image: string;
      }

      const paintings: Painting[] = JSON.parse(document.getElementById("paintings-data")?.textContent ?? "[]");
      const screen = document.getElementById("screen") as HTMLElement;
      const img = document.getElementById("painting") as HTMLImageElement;
      const title = document.getElementById("title") as HTMLElement;
      const meta = document.getElementById("meta") as HTMLElement;
      const corners = document.getElementById("corners") as HTMLElement;
      const cornerCount = document.getElementById("corner-count") as HTMLElement;

      // Précharge les tableaux et retient leurs proportions
      const ratios: number[] = paintings.map(() => 4 / 3);
      paintings.forEach((p, i) => {
        const pre = new Image();
        pre.onload = () => {
          ratios[i] = pre.naturalWidth / pre.naturalHeight;
          if (i === current) resize();
        };
        pre.src = p.image;
      });

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const SPEED = 90; // px par seconde, lent et régulier

      let current = 0;
      let x = 0;
      let y = 0;
      let w = 0;
      let h = 0;
      let dx = 1;
      let dy = -1;
      let cornerHits = 0;

      // Taille « timbre-poste » : une surface constante quelle que soit la forme du tableau
      function resize() {
        const area = Math.min(window.innerWidth, window.innerHeight) ** 2 * 0.09;
        const r = ratios[current];
        w = Math.sqrt(area * r);
        h = w / r;
        // Ne jamais dépasser l'écran sur les petits formats
        const maxW = window.innerWidth * 0.6;
        const maxH = window.innerHeight * 0.6;
        const s = Math.min(1, maxW / w, maxH / h);
        w *= s;
        h *= s;
        img.style.width = `${w}px`;
        img.style.height = `${h}px`;
        clamp();
      }

      // Garde le tableau dans l'écran (utile quand la forme ou la fenêtre change)
      function clamp() {
        x = Math.min(Math.max(x, 0), Math.max(0, window.innerWidth - w));
        y = Math.min(Math.max(y, 0), Math.max(0, window.innerHeight - h));
      }

      function show(i: number) {
        current = i;
        const p = paintings[i];
        img.src = p.image;
        img.alt = p.title;
        title.textContent = p.title;
        meta.textContent = `${p.painter}, ${p.date} · ${p.owned_by}`;
        resize();
      }

      const nextPainting = () => show((current + 1) % paintings.length);

      function place() {
        img.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      }

      function celebrateCorner() {
        cornerHits += 1;
        cornerCount.textContent = String(cornerHits);
        corners.hidden = false;
        screen.classList.remove("corner");
        void screen.offsetWidth; // relance l'animation
        screen.classList.add("corner");
      }

      // Départ : en bas à gauche, cap vers le coin supérieur droit
      resize();
      x = window.innerWidth * 0.1;
      y = window.innerHeight - h - window.innerHeight * 0.1;
      clamp();
      place();

      if (reduceMotion) {
        // Sans mouvement : tableau centré, qui change toutes les 6 secondes
        const center = () => {
          x = (window.innerWidth - w) / 2;
          y = (window.innerHeight - h) / 2;
          place();
        };
        center();
        window.addEventListener("resize", () => { resize(); center(); });
        setInterval(() => { nextPainting(); center(); }, 6000);
      } else {
        let last = performance.now();

        function tick(now: number) {
          // Plafonne le pas (onglet en arrière-plan) pour ne pas « téléporter » le tableau
          const dt = Math.min((now - last) / 1000, 0.05);
          last = now;

          x += dx * SPEED * dt;
          y += dy * SPEED * dt;

          const maxX = window.innerWidth - w;
          const maxY = window.innerHeight - h;
          let hitX = false;
          let hitY = false;

          if (x <= 0) { x = 0; dx = 1; hitX = true; }
          else if (x >= maxX) { x = maxX; dx = -1; hitX = true; }
          if (y <= 0) { y = 0; dy = 1; hitY = true; }
          else if (y >= maxY) { y = maxY; dy = -1; hitY = true; }

          if (hitX || hitY) {
            nextPainting();
            if (hitX && hitY) celebrateCorner();
          }

          place();
          requestAnimationFrame(tick);
        }

        window.addEventListener("resize", resize);
        requestAnimationFrame((t) => { last = t; tick(t); });
      }
    </script>
  </body>
</html>

<style>
  /* Écran noir plein cadre, comme une télé allumée sans programme */
  :global(html:has(body.screensaver-page)),
  :global(body.screensaver-page) {
    max-width: none;
    margin: 0;
    padding: 0;
    height: 100%;
    overflow: hidden;
    background-color: #000;
    color: #fff;
  }

  .screen {
    position: fixed;
    inset: 0;
    background: #000;
    overflow: hidden;
  }

  .painting {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    object-fit: cover;
    will-change: transform;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Le petit événement : un éclair discret quand le tableau touche un coin pile */
  .screen.corner {
    animation: corner-flash 1.2s ease-out;
  }
  @keyframes corner-flash {
    0% { background: #2a2a2a; }
    100% { background: #000; }
  }

  .home-link,
  .caption,
  .corners {
    position: fixed;
    z-index: 1;
    font-size: 0.8rem;
    color: #8a8a8a;
    margin: 0;
  }

  .home-link {
    top: 16px;
    left: 16px;
    text-decoration: none;
    opacity: 0.6;
    transition: opacity 0.2s;
  }
  .home-link:hover,
  .home-link:focus-visible {
    opacity: 1;
    color: #fff;
    text-decoration: underline;
  }

  .caption {
    left: 16px;
    bottom: 16px;
    line-height: 1.4;
    pointer-events: none;
  }
  .caption p {
    margin: 0;
  }
  .caption .title {
    color: #d0d0d0;
  }

  .corners {
    right: 16px;
    bottom: 16px;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }
</style>
