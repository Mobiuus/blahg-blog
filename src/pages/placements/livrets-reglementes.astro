                <div class:list={["pl-shadow", rot < 0 && "left"]}>
                  <div class="pl-card" style={`background-color: ${THEMES[p.theme].color};`}>
                    <div class="pl-card-inner">
                      <div class="proj-top">
                        <span class="pl-pill">{THEMES[p.theme].label}</span>
                        <span class={`pl-taxo ${p.taxo}`} title={TAXO[p.taxo].short}>{TAXO[p.taxo].label}</span>
                      </div>
                      <h3 class="proj-title">{p.title}</h3>
                      <p class="proj-place">{p.place}</p>
                      <div class="pl-divider"></div>
                      <p class="proj-pitch pl-hand">{p.pitch}</p>
                      <div class="pl-divider"></div>
                      <p class="proj-loan"><span>Prêt</span> {p.loan}</p>
                      {share !== null && (
                        <div class="share" role="img" aria-label={`Le prêt couvre ${share} % du projet`}>
                          <div class="share-bar"><span style={`width: ${share}%`}></span></div>
                          <p class="share-l">{share} % d'un projet de {p.totalLabel}</p>
                        </div>
                      )}
                      {p.year && <p class="proj-year">{p.year}</p>}
                      {(p.details || p.taxoNote) && (
                        <details class="proj-more">
                          <summary>En savoir plus</summary>
