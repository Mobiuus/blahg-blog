<script>
  /* ── Comparatif ── */
  const cmp = document.getElementById("cmp");
  const viewChips = document.querySelectorAll<HTMLButtonElement>(".cmp-controls .pl-chip");
  viewChips.forEach((chip) =>
    chip.addEventListener("click", () => {
      viewChips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      if (cmp) cmp.dataset.view = chip.dataset.view || "both";
    })
  );
  const onlyDiff = document.getElementById("only-diff") as HTMLInputElement | null;
  onlyDiff?.addEventListener("change", () => cmp?.classList.toggle("only-diff", onlyDiff.checked));

  /* ── Calcul ── */
  const range = document.getElementById("calc-amount") as HTMLInputElement | null;
  const fmt = new Intl.NumberFormat("fr-FR", { maximumFractionDigits: 0 });
  const updateCalc = () => {
    if (!range) return;
    const v = Number(range.value);
    const year = v * 0.017;
    document.getElementById("calc-out")!.textContent = `${fmt.format(v)} €`;
    document.getElementById("calc-year")!.textContent = `${fmt.format(year)} €`;
    document.getElementById("calc-month")!.textContent = `${fmt.format(year / 12)} €`;
  };
  range?.addEventListener("input", updateCalc);
  updateCalc();

  /* ── Circuit ── */
  const flowData = JSON.parse(document.getElementById("flow-data")!.textContent || "{}");
  const nodes = document.querySelectorAll<HTMLButtonElement>("#flow .node");
  const panel = document.getElementById("flow-panel")!;
  const fTitle = document.getElementById("flow-title")!;
  const fBody = document.getElementById("flow-body")!;
  const fLink = document.getElementById("flow-link") as HTMLAnchorElement;
  nodes.forEach((n) =>
    n.addEventListener("click", () => {
      const d = flowData[n.dataset.node || ""];
      if (!d) return;
      nodes.forEach((m) => m.setAttribute("aria-pressed", String(m === n)));
      panel.style.backgroundColor = d.color;
      fTitle.textContent = d.amount ? `${d.title} · ${d.amount}` : d.title;
      fBody.textContent = d.body;
      if (d.link) {
        fLink.href = d.link.href;
        fLink.textContent = `${d.link.label} →`;
        fLink.hidden = false;
      } else {
        fLink.hidden = true;
      }
      panel.classList.remove("pop");
      void panel.offsetWidth;
      panel.classList.add("pop");
    })
  );

  /* ── Filtres projets ── */
  const state: Record<string, string> = { theme: "all", taxo: "all" };
  const cards = document.querySelectorAll<HTMLElement>("#projects .project");
  const empty = document.getElementById("projects-empty")!;
  const aqua = document.getElementById("aqua")!;
  const applyFilters = () => {
    let shown = 0;
    cards.forEach((c) => {
      const ok =
        (state.theme === "all" || c.dataset.theme === state.theme) &&
        (state.taxo === "all" || c.dataset.taxo === state.taxo);
      c.hidden = !ok;
      if (ok) shown++;
    });
    empty.hidden = shown > 0;
    aqua.hidden = !(state.theme === "all" || state.theme === "eau");
  };
  document.querySelectorAll<HTMLElement>(".filters [data-group]").forEach((group) => {
    const chips = group.querySelectorAll<HTMLButtonElement>(".pl-chip");
    chips.forEach((chip) =>
      chip.addEventListener("click", () => {
        chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
        state[group.dataset.group!] = chip.dataset.value || "all";
        applyFilters();
      })
    );
  });

  /* ── Apparition au scroll ── */
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }),
    { threshold: 0.12 }
  );
  document.querySelectorAll(".pl-reveal").forEach((el) => io.observe(el));
</script>

