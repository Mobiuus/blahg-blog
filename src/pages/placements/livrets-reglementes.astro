            ))}
          </div>
        </div>
      </div>

      <!-- Focus AquaPrêts -->
      <div class="aqua pl-reveal" id="aqua">
        <p class="aqua-k pl-hand">Zoom : le plan Eau</p>
        <div class="aqua-figs">
          <div><p class="aqua-v">4,4 Md€</p><p class="aqua-l">d'AquaPrêts déployés depuis 2023</p></div>
          <div><p class="aqua-v">≈ 1 300</p><p class="aqua-l">projets financés</p></div>
          <div><p class="aqua-v">6 Md€</p><p class="aqua-l">enveloppe portée d'ici 2028 (au lieu de 4)</p></div>
        </div>
        <p class="aqua-t">Fuites des réseaux, protection des captages, assainissement, prévention des inondations : l'eau est l'un des rares domaines où l'épargne des livrets finance directement de l'<strong>adaptation</strong>.</p>
      </div>

      <div class="pl-wide">
        <div class="projects" id="projects">
          {projects.map((p, i) => {
            const share = p.loanM && p.totalM ? Math.round((p.loanM / p.totalM) * 100) : null;
            const rot = ((i * 7) % 5) - 2;
            return (
              <article
                class="project"
                data-theme={p.theme}
                data-taxo={p.taxo}
                style={`--rot: ${rot * 0.6}deg;`}
