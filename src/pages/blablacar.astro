---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ColorScript from "../components/ColorScript.astro";
import BlaBlaCarInvest from "../components/BlaBlaCarInvest.jsx";
---

<html lang="fr">
  <head>
    <BaseHead title="BlaBlaCar — valorisation" description="Suivi de ma participation indirecte dans BlaBlaCar via SPV Caption Market" />
    <link rel="stylesheet" href="/style/fonts.css" />
    <link rel="stylesheet" href="/style/global.css" />
  </head>
  <body>
    <Header />
    <main>
      <div class="wide">
        <BlaBlaCarInvest client:only="react" />
      </div>
    </main>
    <Footer />
    <ColorScript />
  </body>
</html>

<style>
  main {
    padding: 1rem 0 3rem;
  }
  /* sort de la colonne 70ch du body pour élargir le tableau de bord */
  .wide {
    width: min(1100px, 100vw - 2.5rem);
    position: relative;
    left: 50%;
    transform: translateX(-50%);
  }
</style>
