---
import { getCategories, normalizeNote, sortNotes, slugify } from "../lib/notes";
import { colors as noteColors } from "./notes/utils/colors";
import { getAllBooks } from "../lib/books";
import { getRecentAlbumCovers } from "../lib/lastfm";

// ── Aperçus des dossiers (calculés au build, mêmes sources que les pages) ──
let rawNotes: any[] = [];
try {
  rawNotes = await Astro.glob("../notes/*.md");
} catch {
  rawNotes = [];
}
const notes = rawNotes.map(normalizeNote);
// Même couleur par catégorie que la page Notes (catégories triées par nombre de notes)
const categoryIndex: Record<string, number> = {};
getCategories(notes).forEach((cat, i) => (categoryIndex[cat.slug] = i));
const latestNotes = sortNotes(notes, "newest")
  .slice(0, 3)
  .map((n) => ({
    title: n.title,
    detail: n.description,
    category: n.thema,
    color: noteColors[(categoryIndex[slugify(n.thema)] ?? 0) % noteColors.length],
  }));

// Les 3 derniers livres ajoutés à l'étagère « Lu ! »
const latestBooks = getAllBooks().slice(-3).reverse();

const paintings = [
  { title: "La Gare Saint-Lazare", image: "/assets/paintings/La_Gare_Saint-Lazare_-_Claude_Monet.jpg" },
  { title: "Pluie, Vapeur et Vitesse", image: "/assets/paintings/Turner_-_Rain,_Steam_and_Speed.jpg" },
  { title: "La Pie", image: "/assets/paintings/Claude_Monet_-_La_pie.jpg" },
];

// 3 pochettes de vinyles : albums les plus écoutés du mois (Last.fm), sinon pochettes unies
const sleeveColors = ["#ff8477", "#6ad09d", "#b3cdfb"];
const albums = await getRecentAlbumCovers();
const sleeves = [0, 1, 2].map((i) => ({ cover: albums[i]?.cover ?? "", color: sleeveColors[i] }));

type Kind = "notes" | "books" | "musee" | "music" | "map" | "invest";
interface Folder {
  kind: Kind;
  label: string;
  href: string;
  front: string;
  back: string;
}

const folders: Folder[] = [
  { kind: "notes",  label: "notes",            href: "/notes",     front: "#d4a08f", back: "#bd8676" },
  { kind: "books",  label: "books",            href: "/bookshelf", front: "#c6a77c", back: "#ad8e64" },
  { kind: "musee",  label: "musée imaginaire", href: "https://valentin.vc/musee-imaginaire/", front: "#bca2cf", back: "#a68ab9" },
  { kind: "music",  label: "music",            href: "/music",     front: "#9bb0d9", back: "#8597c4" },
  { kind: "map",    label: "map",              href: "/map",       front: "#d9c58a", back: "#c2ad70" },
  { kind: "invest", label: "invest",          href: "/invest",    front: "#a9c6a2", back: "#8fae88" },
];

// Éventail : angle et décalage de chaque élément selon sa position
const fan = (index: number, count: number) => {
  const centered = index - (count - 1) / 2;
  return `--angle: ${centered * 16}deg; --offset: ${centered * 24}%;`;
};
---
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;700&display=swap" />

<header>
    <div class="header-section">
        <div class="header-frame">
            <h1 class="main-title typing-effect">hi, i'm valentin.</h1>
        </div>
    </div>
</header>
<nav class="folder-nav">
    <ul class="folders" role="list">
        <li>
            <!-- « home » n'a pas de dossier : un espace vide garde son nom aligné avec les autres -->
            <a href="/" class="folder-link">
                <span class="folder folder-spacer" aria-hidden="true"></span>
                <span class="folder-label">home</span>
            </a>
        </li>
        {folders.map((folder) => (
            <li>
                <a href={folder.href} class="folder-link" data-kind={folder.kind}>
                    <span
                        class="folder"
                        data-kind={folder.kind}
                        aria-hidden="true"
                        style={`--folder-front: ${folder.front}; --folder-back: ${folder.back};`}
                    >
                        <span class="folder-back">
                            {folder.kind === "notes" && latestNotes.map((note, i) => (
                                <span class="paper" style={`${fan(i, latestNotes.length)} --note-paper: ${note.color};`}>
                                    <span class="note-card">
                                        <span class="note-pill">{note.category}</span>
                                        <span class="note-title">{note.title}</span>
                                        {note.detail && <span class="note-detail">{note.detail}</span>}
                                    </span>
                                </span>
                            ))}

                            {folder.kind === "books" && latestBooks.map((book, i) => (
                                <span class="paper" style={fan(i, latestBooks.length)}>
                                    <img src={book.coverImage} alt="" loading="lazy" decoding="async" />
                                </span>
                            ))}

                            {folder.kind === "musee" && paintings.map((p, i) => (
                                <span class="paper" style={fan(i, paintings.length)}>
                                    <img src={p.image} alt="" loading="lazy" decoding="async" />
                                </span>
                            ))}

                            {folder.kind === "music" && sleeves.map((s, i) => (
                                <span class="paper" style={`${fan(i, sleeves.length)} background: ${s.color};`}>
                                    {s.cover && <img src={s.cover} alt="" loading="lazy" decoding="async" />}
                                </span>
                            ))}

                            {folder.kind === "map" && (
                                <span class="paper" style={fan(0, 1)}>
                                    <!-- Contour de l'Île-de-France simplifié, généré depuis public/data/idf-network.json -->
                                    <svg class="mini-map" viewBox="0 0 100 80">
                                        <defs>
