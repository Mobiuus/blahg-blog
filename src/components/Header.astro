,8.7 50.1,9.9 49.5,10.7 52.6,11.3 54,12.5Z" />
                                            <clipPath id="mini-idf-clip"><use href="#mini-idf" /></clipPath>
                                        </defs>
                                        <use href="#mini-idf" fill="none" stroke="#252525" stroke-width="2.4" stroke-linejoin="round" />
                                        <use href="#mini-idf" fill="#efefef" stroke="#efefef" stroke-width="0.6" />
                                        <g clip-path="url(#mini-idf-clip)" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M43.7,23.7 42.7,23.7 41.3,25 42.1,26.2 41.9,26.9 44.8,29.3 43.6,30.1 43.1,31.3 43.1,32.9 44.2,35.2 43.7,36.7" stroke="#62259D" />
                                            <path d="M30.5,38.5 34.5,39.1 36.1,38.3 38,38.2 39.5,36.4 40.8,35.6 41.5,32.7 42.7,30.8 42.4,29.4 43.5,26.1 43.3,24 47.1,22.7 50.7,22.6 51.1,21.9 50.4,20.3 50.8,18.3 51.3,17.6 52.9,17.3 53.1,17.7" stroke="#5291CE" />
                                            <path d="M48.7,44.6 48.5,44 46.4,43.7 45,42.4 45.5,41.1 44.6,39.4 45.3,38.4 47.3,37.1 47.5,36.2 46.5,31.2 43,27.7 43.5,25.9 42.9,22.1 50.9,13.5 51.1,10.3 48.6,7.1 47.3,1.9 48.5,-0.2" stroke="#00814F" />
                                            <path d="M0,29 H100" stroke="#252525" stroke-width="0.6" />
                                            <path d="M0,30.2 H100" stroke="#252525" stroke-width="1" stroke-dasharray="0.6 2" stroke-linecap="butt" stroke-opacity="0.5" />
                                            <g class="mini-metro">
                                                <g transform="translate(0 5.3) scale(0.45)" fill="#efefef" stroke="#252525" stroke-width="1.6" stroke-linejoin="round">
                                                    <rect x="0" y="38" width="27" height="12" rx="2" />
                                                    <path d="M30,38 H52 Q58,38 59.5,45 V50 H30 Z" />
                                                    <path d="M1,46 H26 M31,46 H59" stroke="#E3051C" stroke-width="2.2" />
                                                    <path d="M3,40.5 h4 v3.5 h-4 Z M10,40.5 h4 v3.5 h-4 Z M17,40.5 h4 v3.5 h-4 Z M33,40.5 h4 v3.5 h-4 Z M40,40.5 h4 v3.5 h-4 Z M53,40.5 Q56,40.5 57,44 H53 Z" fill="#b7d2e6" stroke-width="0.8" />
                                                    <circle cx="5" cy="51" r="1.7" />
                                                    <circle cx="22" cy="51" r="1.7" />
                                                    <circle cx="35" cy="51" r="1.7" />
                                                    <circle cx="54" cy="51" r="1.7" />
                                                </g>
                                            </g>
                                        </g>
                                    </svg>
                                </span>
                            )}

                            {folder.kind === "invest" && (
                                <span class="paper" style={fan(0, 1)}>
                                    <svg class="mini-globe" data-mini-globe viewBox="0 0 100 100">
                                        <circle cx="50" cy="50" r="48" fill="#dbe9f4" stroke="#252525" stroke-width="1.2" />
                                    </svg>
                                </span>
                            )}

                            <span class="folder-front"></span>
                            <span class="folder-front right"></span>
                        </span>
                    </span>
                    <span class="folder-label">{folder.label}</span>
                </a>
            </li>
        ))}
    </ul>
</nav>

<script>
    // La mini-Terre (d3-geo depuis un CDN) n'est chargée qu'au premier survol du dossier
    // « invest », ou tout de suite sur écran tactile où les dossiers sont toujours ouverts.
    const investLink = document.querySelector<HTMLElement>('.folder-link[data-kind="invest"]');
    let globeLoaded = false;
    const loadGlobe = () => {
        if (globeLoaded) return;
        globeLoaded = true;
        const url = "/scripts/mini-globe.js";
        import(/* @vite-ignore */ url).catch((err) => console.error("mini-globe", err));
    };
    if (investLink) {
        investLink.addEventListener("pointerenter", loadGlobe, { once: true });
        investLink.addEventListener("focus", loadGlobe, { once: true });
        if (window.matchMedia("(hover: none)").matches) loadGlobe();
    }
</script>

<style>
    h2 {
        margin: 0.5em 0;
    }

    /* ── Navigation en dossiers (inspirée de iamrob.in) ── */
    .folder-nav {
        position: relative; /* plus de barre collante : les dossiers prennent de la place */
        text-align: center;
        padding-bottom: 0.75rem;
    }
    .folders {
        --folder-w: 3.4rem;
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 0.25rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .folders li {
        display: flex;
        justify-content: center;
    }
    .folder-link {
        --folder-open: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        /* place au-dessus pour ce qui sort du dossier */
        padding: calc(var(--folder-w) * 0.65) 0.25rem 0.25rem;
        margin: 0 !important;
        color: inherit;
        text-decoration: none;
        border-radius: 8px;
    }
    .folder-link:focus-visible {
        --folder-open: 1;
        outline: 2px solid var(--text-color);
        outline-offset: 2px;
    }
    /* Pas de soulignement par défaut ; au survol, soulignement de la couleur aléatoire
       que ColorScript attribue au lien (comme pour les autres liens du site) */
    .folder-label {
        font-size: 0.85rem;
        line-height: 1.2;
        text-decoration: none;
    }
    .folder-link:hover .folder-label,
    .folder-link:focus-visible .folder-label {
        text-decoration-line: underline;
        text-decoration-thickness: 3px;
        text-underline-offset: 5px;
        text-decoration-color: inherit;
    }

    .folder {
        /* Un seul état pilote le survol, le focus clavier et l'ouverture permanente au tactile */
        --folder-lift: calc(-3px * var(--folder-open));
        --front-skew: calc(15deg * var(--folder-open));
        --front-scale: calc(1 - 0.4 * var(--folder-open));
        --paper-shift: calc(10% - 45% * var(--folder-open));
        --fan-spread: var(--folder-open);
        display: block;
        position: relative;
        width: var(--folder-w);
        height: calc(var(--folder-w) * 0.8);
        /* les textes des aperçus sont proportionnels à la taille du dossier */
        font-size: calc(var(--folder-w) / 14);
        pointer-events: none;
        transform: translateY(var(--folder-lift));
    }
    .folder-spacer {
        visibility: hidden;
    }
    .folder-back {
        position: absolute;
        inset: 0;
        background: var(--folder-back);
        border-radius: 0 0.2em 0.2em 0.2em;
    }
    .folder-back::before {
        content: "";
        position: absolute;
        bottom: 100%;
        left: 0;
        width: 30%;
        height: 10%;
        background: inherit;
        border-radius: 0.15em 0.15em 0 0;
    }

    .paper {
        position: absolute;
        bottom: 10%;
        left: 50%;
        width: 65%;
        height: 85%;
        overflow: hidden;
        border-radius: 0.2em;
        background: #fff;
        color: #000;
        outline: 1px solid rgb(0 0 0 / 0.1);
        transform-origin: center bottom;
        transform:
            translate(calc(-50% + var(--offset) * var(--fan-spread)), var(--paper-shift))
            rotate(calc(var(--angle) * var(--fan-spread)));
        text-align: left;
    }
    .paper img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Notes : mini-cartes colorées comme sur la page Notes */
    [data-kind="notes"] .paper {
        padding: 0.3em;
        border-radius: 0;
        background: var(--note-paper);
    }
    .note-card {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5em;
        min-height: 100%;
        box-sizing: border-box;
        border: 1px solid rgb(0 0 0 / 0.6);
        padding: 0.5em;
        font-family: "iA Writer Mono", monospace;
    }
    .note-pill {
        max-width: 100%;
        overflow: hidden;
        white-space: nowrap;
        border: 1px solid rgb(0 0 0 / 0.6);
        border-radius: 999px;
        padding: 0.05em 0.45em;
        font-size: 0.7em;
        line-height: 1.4;
    }
    .note-title {
        font-size: 1em;
        line-height: 1.35;
        font-weight: 700;
        overflow-wrap: anywhere;
    }
    .note-detail {
        border-top: 1px solid rgb(0 0 0 / 0.6);
        padding-top: 0.4em;
        font-family: "Caveat", cursive;
        font-size: 1.1em;
        line-height: 1.2;
    }

    /* Livres : format couverture */
    [data-kind="books"] .paper {
        width: 58%;
        height: 92%;
        border-radius: 0.1em;
    }

    /* Musée : tableaux paysage dans un cadre */
    [data-kind="musee"] .paper {
        width: 82%;
        height: 62%;
        padding: 0.3em;
        background: #f6f1e7;
        border-radius: 0;
        outline: 2px solid #6b5536;
    }

    /* Music : pochettes de vinyles carrées */
    [data-kind="music"] .paper {
        width: 66%;
        height: auto;
        aspect-ratio: 1 / 1;
        border-radius: 0.1em;
        box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.15);
    }

    /* Map : le contour de l'Île-de-France, qui sort franchement du dossier comme la Terre d'invest,
       avec un métro qui fait l'aller-retour quand le dossier est ouvert */
    .folder[data-kind="map"] {
        --paper-shift: calc(0% - 55% * var(--folder-open));
    }
